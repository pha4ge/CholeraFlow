// Only for testing workflow wiring with a fake Bactopia executable.
// All downstream Python processes run normally; no genomic tools are emulated.
params {
    input = "${projectDir}/tests/fixtures/smoke_samplesheet.csv"
    metadata = null
    bactopia_bin = "${projectDir}/tests/fixtures/fake_bactopia.py"
    bactopia_profile = null
    run_phylogeny = false
    run_cgmlst = false
    run_amr = false
    run_virulence = false
    max_memory = '1.GB'
    max_cpus = 1
}
process.executor = 'local'
docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
conda.enabled = false
