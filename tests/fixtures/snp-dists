#!/usr/bin/env python3
"""TEST DOUBLE ONLY for workflow wiring, not a substitute for snp-dists validation."""
from pathlib import Path
import sys

path = Path(sys.argv[-1])
records = {}
for line in path.read_text().splitlines():
    if line.startswith('>'):
        name = line[1:]
        records[name] = ''
    elif line:
        records[name] += line
assert len(records) == 4 and all(n.startswith('SYNTHETIC_') for n in records)
print('\t' + '\t'.join(records))
for name, seq in records.items():
    print(name + '\t' + '\t'.join(str(sum(a != b for a, b in zip(seq, other)))
                                  for other in records.values()))
