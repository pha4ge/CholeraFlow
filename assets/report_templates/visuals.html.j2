{# Scientific figures with readable, responsive geometry and complete source tables. #}
{%- from 'partials/icons.html.j2' import icon -%}
{% macro chart_card(chart) -%}
{% set distribution = chart.source_unit is defined %}
{% set width = 620 %}
{% set peak = chart.rows|map(attribute='value')|max if chart.kind == 'bars' and chart.rows else 1 %}
{% set height = 300 if distribution else (100 + chart.plotted|length * 38 if chart.kind == 'bars' else 350) %}
<figure class="chart-card cf-chart-card" id="chart-{{ chart.id }}" data-scope="{{ 'filterable' if chart.sample_marks else 'fixed' }}">
  <header class="chart-heading"><div><p class="cf-chart-eyebrow">{{ 'Pairwise distribution' if distribution else ('Individual observations' if chart.sample_marks or chart.kind == 'scatter' else 'Recorded composition') }}</p><h3 id="title-{{ chart.id }}">{{ chart.title }}</h3></div><button class="button js-svg-export" type="button" hidden aria-label="Download {{ chart.title }} as SVG">{{ icon('download') }} SVG</button></header>
  {% if chart.status == 'ok' %}
  <div class="chart-viewport cf-chart-viewport" tabindex="0" role="region" aria-label="{{ chart.title }} graphic">
  <svg class="report-chart cf-svg" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-labelledby="title-{{ chart.id }} desc-{{ chart.id }}">
    <desc id="desc-{{ chart.id }}">{{ chart.title }}. {{ chart.note }} Complete values appear in the source table.</desc>
    {% if distribution %}
      {% set n = chart.plotted|length %}{% set slot = 480 / (n or 1) %}
      {% for fraction in [0, 0.5, 1] %}{% set y = 220 - 175*fraction %}<line class="cf-chart-gridline" x1="62" x2="554" y1="{{ y }}" y2="{{ y }}"/><text class="cf-chart-tick" x="50" y="{{ y+4 }}" text-anchor="end">{{ (peak*fraction)|round(1) }}</text>{% endfor %}
      {% for row in chart.plotted %}{% set x = 70 + loop.index0*slot + slot/2 %}{% set h = 175 * (row.value / peak) if peak else 0 %}
      <g><title>{{ row.label }} {{ chart.source_unit }}: {{ row.display }} pairs</title>
      {% if chart.dot_plot %}<line class="cf-chart-stem" x1="{{ x }}" x2="{{ x }}" y1="220" y2="{{ 220-h }}"/><circle class="cf-chart-dot" cx="{{ x }}" cy="{{ 220-h }}" r="7"/>{% else %}<rect class="cf-chart-bar" x="{{ x - [28,slot*0.32]|min }}" y="{{ 220-h }}" width="{{ [56,slot*0.64]|min }}" height="{{ h }}" rx="3"/>{% endif %}
      <text class="cf-chart-value" x="{{ x }}" y="{{ 207-h }}" text-anchor="middle">{{ row.display }}</text><text class="cf-chart-tick" x="{{ x }}" y="242" text-anchor="middle">{{ row.label }}</text></g>{% endfor %}
      <text class="cf-chart-axis-label" x="310" y="280" text-anchor="middle">{{ chart.source_unit }} · each unordered pair counted once</text><text class="cf-chart-tick" x="62" y="20">Number of pairs</text>
    {% elif chart.kind == 'bars' %}
      {% for fraction in [0, 0.5, 1] %}{% set x = 218 + fraction*306 %}<line class="cf-chart-gridline" x1="{{ x }}" x2="{{ x }}" y1="20" y2="{{ height-60 }}"/><text class="cf-chart-tick" x="{{ x }}" y="{{ height-36 }}" text-anchor="middle">{{ (peak*fraction)|round(2) }}</text>{% endfor %}
      {% for row in chart.plotted %}{% set y = 37 + loop.index0*38 %}{% set length = 306 * (row.value/peak) if peak else 0 %}
      <g{% if chart.sample_marks %} data-cf-source-label="{{ row.label }}"{% endif %}><title>{{ row.label }}: {{ row.display }} {{ chart.unit }}</title>
      <text class="cf-chart-label{{ ' cf-chart-mono' if chart.sample_marks else '' }}" x="200" y="{{ y+5 }}" text-anchor="end">{{ row.label|truncate(28,true) }}</text>
      {% if chart.dot_plot %}<line class="cf-chart-stem" x1="218" x2="{{ 218+length }}" y1="{{ y }}" y2="{{ y }}"/><circle class="cf-chart-dot" cx="{{ 218+length }}" cy="{{ y }}" r="6"/>{% else %}<rect class="cf-chart-track" x="218" y="{{ y-9 }}" width="306" height="18" rx="3"/><rect x="218" y="{{ y-9 }}" width="{{ length }}" height="18" rx="3" fill="{{ row.color }}"/>{% endif %}
      <text class="cf-chart-value" x="{{ 230+length }}" y="{{ y+5 }}">{{ row.display }}</text></g>{% endfor %}
      <text class="cf-chart-axis-label" x="218" y="{{ height-10 }}">{{ chart.unit }}</text>
    {% else %}
      {% for f in [0,0.25,0.5,0.75,1] %}{% set y=270-220*f %}<line class="cf-chart-gridline" x1="76" x2="560" y1="{{ y }}" y2="{{ y }}"/>{% endfor %}
      <path class="cf-chart-axis" d="M76 48V270H560"/>
      {% for point in chart.points %}<circle class="cf-chart-dot" data-cf-source-label="{{ point.label }}" cx="{{ 76+(point.x-70)*484/510 }}" cy="{{ 270-(285-point.y)*220/245 }}" r="6"><title>{{ point.label }} · {{ chart.x_label }}: {{ point.x_display }} · {{ chart.y_label }}: {{ point.y_display }}</title></circle>{% endfor %}
      <text class="cf-chart-axis-label" x="318" y="327" text-anchor="middle">{{ chart.x_label }}</text><text class="cf-chart-axis-label" x="18" y="160" transform="rotate(-90 18 160)" text-anchor="middle">{{ chart.y_label }}</text>
      <text class="cf-chart-tick" x="76" y="292">0</text><text class="cf-chart-tick" x="560" y="292" text-anchor="end">{{ chart.x_max }}</text><text class="cf-chart-tick" x="65" y="54" text-anchor="end">{{ chart.y_max }}</text>
    {% endif %}
  </svg></div>
  <figcaption><div class="chart-meta">{% if chart.source_count is defined %}<strong>{{ chart.source_count }}</strong> {{ chart.source_label }} · {{ chart.n }} {{ chart.category_label }}{% else %}<strong>{{ chart.n }}</strong> valid observations{% endif %} · {{ chart.missing }} unavailable/invalid {{ chart.omitted_label|default('values') }}{% if chart.shown < chart.n %} · first {{ chart.shown }} displayed; complete values below{% endif %}</div>
    {% if chart.statistics %}<dl class="mini-stats">{% for label,value in chart.statistics.items() %}<div><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>{% endif %}
    {% if chart.note %}<p class="muted">{{ chart.note }}</p>{% endif %}
  </figcaption>
  <details class="chart-data"><summary>Explore source values <span>{{ chart.rows|length }} rows</span></summary><div class="scroll"><table aria-label="{{ chart.title }} source data"><tr><th>{{ 'Sample' if chart.kind == 'scatter' else 'Sample / category' }}</th>{% if chart.kind == 'scatter' %}<th>{{ chart.x_label }}</th><th>{{ chart.y_label }}</th>{% else %}<th>{{ chart.unit }}</th>{% endif %}</tr>{% for row in chart.rows %}<tr><td>{{ row.label }}</td>{% if chart.kind == 'scatter' %}<td>{{ row.x_value }}</td><td>{{ row.y_value }}</td>{% else %}<td>{{ row.value }}</td>{% endif %}</tr>{% endfor %}</table></div></details>
  {% else %}<div class="not-performed">No valid observations were supplied.{% if chart.missing %} {{ chart.missing }} missing or invalid values remain unavailable.{% endif %}</div>{% endif %}
</figure>
{%- endmacro %}
{% macro chart_grid(charts) -%}<div class="charts-grid">{% for chart in charts %}{{ chart_card(chart) }}{% endfor %}</div>{%- endmacro %}
