.cf-component-card { border-top:2px solid var(--cf-accent);box-shadow:none; }
.cf-component-card .cf-panel-body > p strong { display:block;font-size:38px;line-height:1.4;font-weight:600;letter-spacing:-.04em;color:var(--cf-text); }
.cf-component-card .cf-panel-body > p { font-size:11px;color:var(--cf-text-2); }
.cf-component-card ul { display:flex;flex-wrap:wrap;gap:7px;list-style:none;padding:0;margin:14px 0 0; }
.cf-component-card li { border:1px solid var(--cf-border);border-radius:5px;padding:6px 8px;background:var(--cf-surface-2); }
.cf-component-card li .cf-id { font-size:10px; }
