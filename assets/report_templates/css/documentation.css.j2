/* documentation slice styles — use design tokens only (see css/tokens.css.j2); include dark-mode and @media print rules where needed. */

.cf-download-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr)); gap:14px; }
.cf-download-item { padding:16px; border:1px solid var(--cf-border); border-radius:8px; background:var(--cf-surface); }
.cf-download-item .cf-btn { white-space:normal; text-align:left; }
