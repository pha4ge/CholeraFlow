.cf-workflow-scroll { overflow:auto; } .cf-workflow { width:100%; min-width:860px; }
.cf-wf-stage { fill:var(--cf-surface-2); stroke:var(--cf-border); }
.cf-wf-heading { fill:var(--cf-text-2); font:600 12px var(--cf-font-sans); letter-spacing:.5px; }
.cf-wf-line { fill:none; stroke-width:5; stroke-linecap:round; } .cf-wf-backbone { stroke:var(--cf-text); } .cf-wf-characterisation { stroke:#087f8c; } .cf-wf-phylogeny { stroke:#059669; } .cf-wf-cgmlst { stroke:#2563eb; }
.cf-wf-stop { fill:var(--cf-surface); stroke:var(--cf-text); stroke-width:3; }
.cf-wf-label { fill:var(--cf-text); font:600 12px var(--cf-font-sans); } .cf-wf-detail { fill:var(--cf-text-2); font:11px var(--cf-font-sans); }
.cf-workflow a:hover .cf-wf-stop, .cf-workflow a:focus .cf-wf-stop { stroke:var(--cf-accent); stroke-width:5; }
