/* An editorial opening, with an original non-analytical bacterial/branch motif. */
.cf-hero { background:#102a43; border-radius:12px; padding:30px 32px 26px; }
.cf-hero-text { position:relative; z-index:1; }
.cf-hero-title { max-width:760px; font-size:clamp(28px,3vw,42px); font-weight:650; letter-spacing:-.045em; }
.cf-hero-subtitle { max-width:680px; font-size:15px; line-height:1.65; }
.cf-hero-art { position:absolute; right:28px; top:20px; width:200px; height:180px; color:#5eead4; opacity:.18; }
.cf-hero-meta { margin-top:22px; gap:7px; }
.cf-hero-meta li { border-radius:5px; font-size:10px; }
.cf-metric-grid { gap:12px; }
.cf-metric { border-radius:10px; min-height:134px; padding:15px 16px; box-shadow:none; border-top:2px solid var(--cf-border); }
.cf-metric-value { font-size:34px; font-weight:600; letter-spacing:-.04em; }
.cf-metric--review { border-top-color:var(--cf-indigo); }
.cf-metric-note { line-height:1.55; }
.cf-availability-item { border-radius:7px; }
@media(min-width:1300px){.cf-hero-title,.cf-hero-subtitle{max-width:calc(100% - 190px);}}
@media(max-width:760px){.cf-hero-art{display:none;}.cf-hero-title{font-size:29px;}.cf-hero{padding:24px 20px;}}
