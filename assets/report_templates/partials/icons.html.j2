{#- icon(name): decorative inline SVG (aria-hidden) unless a label is supplied. -#}
{%- macro icon(name, cls='', label=none) -%}
<svg class="cf-icon{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"{% if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true"{% endif %}>{{ _CF_ICONS.get(name, _CF_ICONS['circle-dashed'])|safe }}</svg>
{%- endmacro -%}
{#- icon_templates(): inert <template> clones for icons created by the report script. -#}
{%- macro icon_templates() -%}
<template id="cf-icon-templates">{% for name in _CF_ICONS %}<svg class="cf-icon" data-icon="{{ name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">{{ _CF_ICONS[name]|safe }}</svg>{% endfor %}</template>
{%- endmacro -%}
