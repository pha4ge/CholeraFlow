{% macro distance_map(v, kind) %}
<div class="cf-figure-viewport cf-distance-viewport" tabindex="0" role="region" aria-label="Interactive {{ kind }} heatmap"><svg class="cf-svg cf-distance-map" style="max-width:{{ [v.width,850]|min }}px" viewBox="0 0 {{ v.width }} {{ v.height }}" role="img" aria-label="Pairwise {{ kind }} distance heatmap" data-distance-kind="{{ kind }}">
<text class="cf-chart-tick" x="10" y="20">{{ 'SNP differences' if kind == 'snp' else 'Allele differences' }}</text>
{% for step in range(9) %}<rect class="cf-seq-{{ kind }}-{{ step }}" x="{{ 10+step*14 }}" y="30" width="14" height="9"/>{% endfor %}<text class="cf-chart-tick" x="10" y="56">0</text><text class="cf-chart-tick" x="136" y="56" text-anchor="end">{{ v.maximum }}</text><rect x="10" y="75" width="13" height="13" fill="url(#cf-hatch)"/><text class="cf-chart-tick" x="30" y="86">NA · unavailable</text>
{% for label in v.labels %}{% set x=v.left+loop.index0*v.size+v.size/2 %}{% set y=v.top+loop.index0*v.size+v.size/2 %}<text class="cf-chart-label cf-chart-mono" x="{{ v.left-12 }}" y="{{ y+4 }}" text-anchor="end">{{ label|truncate(25,true) }}</text><text class="cf-chart-label cf-chart-mono" x="{{ x+4 }}" y="{{ v.top-12 }}" transform="rotate(-55 {{ x+4 }} {{ v.top-12 }})">{{ label|truncate(25,true) }}</text>{% endfor %}
{% for cell in v.cells %}<g{% if cell.numeric %} class="cf-distance-pair" data-a="{{ cell.a }}" data-b="{{ cell.b }}" data-distance="{{ cell.text }}" tabindex="0" role="button" aria-label="{{ cell.a }} and {{ cell.b }}: {{ cell.text }} {{ 'SNPs' if kind == 'snp' else 'allele differences' }}"{% endif %}><title>{{ cell.a }} ↔ {{ cell.b }}: {{ cell.text }} {{ 'SNPs' if kind == 'snp' else 'allele differences' }}</title><rect class="cf-seq-{{ cell.tone }} cf-distance-tile{{ ' cf-distance-diagonal' if cell.diagonal else '' }}" x="{{ cell.x }}" y="{{ cell.y }}" width="{{ v.size-2 }}" height="{{ v.size-2 }}" rx="3"{% if not cell.numeric %} fill="url(#cf-hatch)"{% endif %}/>{% if v.shown <= 12 %}<text class="cf-distance-number{{ ' is-dark' if cell.numeric and cell.tone.split('-')[-1]|int >= 5 else '' }}" x="{{ cell.x+v.size/2-1 }}" y="{{ cell.y+v.size/2+4 }}" text-anchor="middle">{{ cell.text }}</text>{% endif %}</g>{% endfor %}</svg></div>
<p class="muted">{{ v.shown }} of {{ v.total }} identifiers, in supplied source order{% if v.shown < v.total %}; first {{ v.shown }} displayed{% endif %}. Select a numeric tile to inspect the original comparison. Complete matrices are available in Downloads.</p>
{% endmacro %}
