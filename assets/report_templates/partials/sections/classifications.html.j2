{%- from 'partials/macros.html.j2' import page_header, page_footer, panel, figure, notice, empty_state, status_badge, badge, sample_id, disclosure, legend, kv, metric_card, tabs, tabpanel -%}
{%- from 'partials/icons.html.j2' import icon -%}
{%- from 'visuals.html.j2' import chart_grid, chart_card -%}
{%- from 'partials/tree.html.j2' import tree_panel -%}
{%- from 'partials/network.html.j2' import network_panel -%}
{%- set page = nav.pages['classifications'] -%}
{{ page_header(page, 'Supplied MLST, lineage and plasmid-cluster records. Schemes remain distinct; nothing is inferred from other classifications.') }}
<div class="cf-tabs" data-cf-tabs id="classification-views" data-label="Classification source"><section class="cf-tabpanel" id="classification-mlst" data-tab-title="MLST"><h3>MLST typing</h3>{{ chart_grid(charts.mlst) }}
{% if mlst %}<div class="scroll"><table aria-label="MLST typing with provenance"><tr><th>Sample</th><th>Status</th><th>Scheme</th><th>Sequence type</th><th>Exact allele profile</th><th>Source</th><th>SHA-256</th></tr>{% for row in mlst %}<tr><td>{{ row.sample }}</td><td>{{ row.status }}</td><td>{{ row.scheme }}</td><td>{{ row.sequence_type }}</td><td>{{ row.allele_profile }}</td><td>{{ row.source_file }}</td><td>{{ row.source_sha256 }}</td></tr>{% endfor %}</table></div>{% else %}<p class="not-performed">No existing MLST output was supplied. Sequence types are not inferred from other classifications.</p>{% endif %}
</section><section class="cf-tabpanel" id="classification-lineage" data-tab-title="Reported lineages"><h3>Reported lineage classifications</h3>{{ chart_grid(charts.lineages) }}
{% if lineages %}<div class="scroll"><table aria-label="Reported lineage classifications"><tr><th>Sample</th><th>Lineage</th><th>Scheme</th><th>Reference revision</th><th>Method</th></tr>{% for row in lineages %}<tr><td>{{ row.sample }}</td><td>{{ row.lineage }}</td><td>{{ row.scheme }}</td><td>{{ row.reference }}</td><td>{{ row.method }}</td></tr>{% endfor %}</table></div>{% else %}<p class="not-performed">Lineage classification was not performed: a reviewed scheme/reference or existing assignment table has not been configured. MLST sequence type is not a lineage.</p>{% endif %}
</section><section class="cf-tabpanel" id="classification-plasmid" data-tab-title="Plasmid memberships"><h3>Reported plasmid clusters</h3>{{ chart_grid(charts.plasmids) }}
{% if plasmids %}<div class="scroll"><table aria-label="Reported plasmid cluster memberships"><tr><th>Sample</th><th>Cluster</th><th>Scheme</th><th>Reference revision</th><th>Method</th></tr>{% for row in plasmids %}<tr><td>{{ row.sample }}</td><td>{{ row.cluster_id }}</td><td>{{ row.scheme }}</td><td>{{ row.reference }}</td><td>{{ row.method }}</td></tr>{% endfor %}</table></div>{% else %}<p class="not-performed">No plasmid-cluster classifier output was supplied. Clusters and transfer events are not inferred from resistance genes or MLST.</p>{% endif %}
</section></div>{{ page_footer(page) }}
