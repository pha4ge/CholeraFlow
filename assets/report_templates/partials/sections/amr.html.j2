{%- from 'partials/macros.html.j2' import page_header, page_footer, panel, figure, notice, empty_state, status_badge, badge, sample_id, disclosure, legend, kv, metric_card, tabs, tabpanel -%}
{%- from 'partials/icons.html.j2' import icon -%}
{%- from 'visuals.html.j2' import chart_grid, chart_card -%}
{%- from 'partials/tree.html.j2' import tree_panel -%}
{%- from 'partials/network.html.j2' import network_panel -%}
{%- set page = nav.pages['amr'] -%}
{%- from 'partials/marker_matrix.html.j2' import marker_matrix -%}
{{ page_header(page, 'Existing acquired AMR marker calls. Marker absence is not phenotypic susceptibility; genotype does not establish phenotype.') }}
{% call panel('The reported marker landscape', 'table-2', 'One row per report sample. Calls remain tied to their original source.') %}
{{ marker_matrix(views.markers.amr, 'amr') }}
{% endcall %}
<details class="cf-disclosure"><summary>Detection frequencies and assessment denominators</summary>{{ chart_grid(charts.amr) }}</details>
{% if amr.rows %}<details class="cf-disclosure"><summary>Original reported AMR records and SXT-associated pattern</summary><div class="scroll"><table aria-label="Original AMR records"><tr><th>Sample</th><th>Source status</th>{% for col, genes_col, label in amr.classes %}<th>{{ label }}</th>{% endfor %}<th>SXT-associated MDR pattern</th></tr>
{% for r in amr.rows %}<tr><td>{{ r.sample }}</td><td>{{ r.status }}</td>{% for col,genes_col,label in amr.classes %}<td>{% if r[col]|lower in ['not_run','not_performed','no_schema',''] %}not run{% else %}{{ r[col] }}{% if r[genes_col] %}: {{ r[genes_col] }}{% endif %}{% endif %}</td>{% endfor %}<td>{{ 'not run' if r.sxt_mdr|lower in ['not_run','not_performed','no_schema',''] else r.sxt_mdr }}</td></tr>{% endfor %}</table></div></details>{% endif %}
{% for sample in model.samples %}{% for flag in sample.flags if 'amr' in flag.evidence %}{% call notice(flag.title, 'review') %}<p>{{ sample_id(sample.id) }} · {{ flag.message }}</p>{% endcall %}{% endfor %}{% endfor %}
{{ page_footer(page) }}
