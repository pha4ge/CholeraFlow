{% macro mark(m) -%}
<g{% if m.id %} data-cf-sample="{{ m.id }}" data-cf-select="{{ m.id }}"{% endif %}><title>{{ m.tip }}</title>
{% if m.shape == 'square' %}<rect class="cf-tone-{{ m.tone }} cf-qc-mark" x="{{ m.x-m.r }}" y="{{ m.y-m.r }}" width="{{ m.r*2 }}" height="{{ m.r*2 }}" rx="1"/>{% elif m.shape == 'triangle' %}<path class="cf-tone-{{ m.tone }} cf-qc-mark" d="M{{ m.x }} {{ m.y-m.r-1 }}l{{ m.r+1 }} {{ m.r*2+2 }}h-{{ m.r*2+2 }}Z"/>{% else %}<circle class="cf-tone-{{ m.tone }} cf-qc-mark" cx="{{ m.x }}" cy="{{ m.y }}" r="{{ m.r }}"/>{% endif %}</g>
{%- endmacro %}
{% macro box(b) %}{% if b %}<g class="cf-qc-box"><title>{{ b.text }}</title><line x1="{{ b.lo }}" x2="{{ b.hi }}" y1="{{ b.cy }}" y2="{{ b.cy }}"/><rect x="{{ b.q1 }}" y="{{ b.y }}" width="{{ b.q3-b.q1 }}" height="{{ b.h }}"/><line x1="{{ b.median }}" x2="{{ b.median }}" y1="{{ b.y }}" y2="{{ b.y+b.h }}"/></g>{% endif %}{% endmacro %}
{% macro metrics(c) %}
<div class="cf-figure-viewport cf-qc-board" tabindex="0" role="region" aria-label="Quality metric plots"><svg class="cf-svg cf-qc-svg" style="max-width:{{ c.width }}px;min-width:{{ [c.width,940]|min }}px;margin:0 auto" viewBox="0 0 {{ c.width }} {{ c.height }}" role="img" aria-label="Measured QC values by sample or distribution">
{% if c.form == 'dots' %}
{% for row in c.rows %}{% if row.band %}<rect class="cf-chart-track" x="0" y="{{ row.band_y }}" width="{{ c.width }}" height="{{ c.row_h }}"/>{% endif %}<text class="cf-chart-label cf-chart-mono" x="{{ c.label_w-12 }}" y="{{ row.y+4 }}" text-anchor="end">{{ row.id|truncate(28,true) }}</text>{% endfor %}
{% for p in c.panels %}<text class="cf-chart-label" x="{{ p.col_x+12 }}" y="18">{{ p.label }}</text><text class="cf-chart-tick" x="{{ p.col_x+12 }}" y="35">{{ p.unit }} · {{ p.n }}/{{ p.total }} measured</text>
{% if p.axis %}{% for tick in p.axis.ticks %}<line class="cf-chart-gridline" x1="{{ tick.pos }}" x2="{{ tick.pos }}" y1="48" y2="{{ c.axis_y }}"/><text class="cf-chart-tick" x="{{ tick.pos }}" y="{{ c.axis_y+20 }}" text-anchor="middle">{{ tick.text }}</text>{% endfor %}{% endif %}
{% if p.threshold %}<line class="cf-qc-threshold" x1="{{ p.threshold.pos }}" x2="{{ p.threshold.pos }}" y1="48" y2="{{ c.axis_y }}"><title>{{ p.threshold.label }}</title></line><text class="cf-chart-tick" x="{{ p.threshold.pos }}" y="45" text-anchor="middle">{{ p.threshold.text }}% max</text>{% endif %}
{% for m in p.cells %}{% if m.kind == 'value' %}{{ mark(m) }}<text class="cf-chart-tick" x="{{ m.label_x }}" y="{{ m.y+4 }}" text-anchor="{{ m.anchor }}">{{ m.label }}</text>{% else %}<text class="cf-chart-tick" x="{{ m.x }}" y="{{ m.y+4 }}"><title>{{ m.tip }}</title>NA</text>{% endif %}{% endfor %}{% endfor %}
{% elif c.form == 'strip' %}
{% for p in c.panels %}<text class="cf-chart-label" x="28" y="{{ p.y0+16 }}">{{ p.label }} · {{ p.unit }}</text><text class="cf-chart-tick" x="{{ c.width-28 }}" y="{{ p.y0+16 }}" text-anchor="end">{{ p.n }} measured · {{ p.omitted }} unavailable</text>{{ box(p.box) }}{% for m in p.marks %}{{ mark(m) }}{% endfor %}{% if p.axis %}{% for tick in p.axis.ticks %}<text class="cf-chart-tick" x="{{ tick.pos }}" y="{{ p.axis_y+18 }}" text-anchor="middle">{{ tick.text }}</text>{% endfor %}{% endif %}{% endfor %}
{% else %}{% for p in c.panels %}<text class="cf-chart-label" x="{{ p.x+10 }}" y="{{ p.y+18 }}">{{ p.label }} · {{ p.unit }}</text><text class="cf-chart-tick" x="{{ p.x+10 }}" y="{{ p.y+33 }}">{{ p.n }} measured · {{ p.omitted }} unavailable</text>{{ box(p.box) }}{% for tick in p.yaxis.ticks %}<line class="cf-chart-gridline" x1="{{ p.x0 }}" x2="{{ p.x1 }}" y1="{{ tick.pos }}" y2="{{ tick.pos }}"/><text class="cf-chart-tick" x="{{ p.x0-8 }}" y="{{ tick.pos+4 }}" text-anchor="end">{{ tick.text }}</text>{% endfor %}
{% for bin in p.bins %}{% for seg in bin.segments %}<rect class="cf-tone-{{ seg.tone }}" x="{{ bin.x }}" y="{{ seg.y }}" width="{{ bin.w }}" height="{{ seg.h }}" rx="1"><title>{{ bin.tip }}</title></rect>{% endfor %}{% endfor %}{% for tick in p.axis.ticks %}<text class="cf-chart-tick" x="{{ tick.pos }}" y="{{ p.base+20 }}" text-anchor="middle">{{ tick.text }}</text>{% endfor %}{% for m in p.outliers|default([]) %}{{ mark(m) }}{% endfor %}{% endfor %}{% endif %}
</svg></div>
{% endmacro %}
{% macro scatter(c) %}
<div class="cf-figure-viewport" tabindex="0" role="region" aria-label="Scatter plot"><svg class="cf-svg cf-qc-scatter" viewBox="0 0 {{ c.width }} {{ c.height }}" role="img" aria-label="{{ c.x_label }} versus {{ c.y_label }}">
{% for tick in c.xaxis.ticks %}<line class="cf-chart-gridline" x1="{{ tick.pos }}" x2="{{ tick.pos }}" y1="{{ c.plot.y0 }}" y2="{{ c.plot.y1 }}"/><text class="cf-chart-tick" x="{{ tick.pos }}" y="{{ c.plot.y1+22 }}" text-anchor="middle">{{ tick.text }}</text>{% endfor %}{% for tick in c.yaxis.ticks %}<line class="cf-chart-gridline" x1="{{ c.plot.x0 }}" x2="{{ c.plot.x1 }}" y1="{{ tick.pos }}" y2="{{ tick.pos }}"/><text class="cf-chart-tick" x="{{ c.plot.x0-10 }}" y="{{ tick.pos+4 }}" text-anchor="end">{{ tick.text }}</text>{% endfor %}
{% for m in c.marks %}{{ mark(m) }}{% endfor %}{% for label in c.labels %}<text class="cf-chart-label cf-chart-mono" x="{{ label.x }}" y="{{ label.y }}" text-anchor="{{ label.anchor }}">{{ label.id }}</text>{% endfor %}
<text class="cf-chart-axis-label" x="{{ c.width/2 }}" y="{{ c.height-7 }}" text-anchor="middle">{{ c.x_label }}</text><text class="cf-chart-axis-label" x="14" y="{{ c.height/2 }}" text-anchor="middle" transform="rotate(-90 14 {{ c.height/2 }})">{{ c.y_label }}</text>
</svg></div>
{% endmacro %}
