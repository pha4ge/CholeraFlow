/* Progressive enhancement: all results remain readable without JavaScript. */
(() => {
  "use strict";
  const collator = new Intl.Collator(undefined, {numeric: true, sensitivity: "base"});
  const cellText = cell => (cell.querySelector(".sr-only") || cell).textContent.trim();
  const make = (tag, text, className) => {
    const element = document.createElement(tag);
    if (text !== undefined) element.textContent = text;
    if (className) element.className = className;
    return element;
  };
  const download = (text, filename, type) => {
    const url = URL.createObjectURL(new Blob([text], {type}));
    const link = make("a");
    link.href = url;
    link.download = filename;
    document.body.append(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  };
  // Quoting alone does not stop spreadsheet formula execution on CSV import.
  const csvCell = value => {
    let text = String(value).trim();
    if (/^[=+\-@\t\r\n]/.test(text)) text = "'" + text;
    return '"' + text.replace(/"/g, '""') + '"';
  };

  document.querySelectorAll("section .scroll table:not(.matrix-table)").forEach((table, index) => {
    const rows = Array.from(table.rows);
    if (rows.length < 2 || !rows[0].querySelector("th")) return;
    table.classList.add("data-table");
    const section = table.closest("section");
    const title = table.getAttribute("aria-label") || section.querySelector("h2").textContent.trim();
    const body = document.createElement("tbody");
    const head = document.createElement("thead");
    head.append(rows[0]);
    rows.slice(1).forEach(row => body.append(row));
    table.replaceChildren(head, body);
    table.setAttribute("aria-label", title);
    const scroll = table.closest(".scroll");
    scroll.tabIndex = 0;
    scroll.setAttribute("role", "region");
    scroll.setAttribute("aria-label", title + " table; scroll horizontally for more columns");
    const controls = make("div", undefined, "table-tools");
    const label = make("label", "Filter rows");
    const input = make("input");
    input.type = "search";
    input.id = "table-filter-" + index;
    input.placeholder = "Sample or any value…";
    input.setAttribute("aria-label", "Filter " + title + " table");
    label.htmlFor = input.id;
    label.append(input);
    const count = make("span", undefined, "table-count");
    count.setAttribute("aria-live", "polite");
    count.setAttribute("aria-atomic", "true");
    const noMatches = make("p", "No rows match this filter. Clear the search to show all results.", "no-matches");
    noMatches.hidden = true;
    const dataRows = rows.slice(1);
    const searchText = new Map(dataRows.map(row => [row, Array.from(row.cells).map(cellText).join(" ").toLocaleLowerCase()]));
    const filter = () => {
      const query = input.value.trim().toLocaleLowerCase();
      let visible = 0;
      dataRows.forEach(row => {
        row.hidden = !searchText.get(row).includes(query);
        if (!row.hidden) visible++;
      });
      count.textContent = visible + " of " + dataRows.length + " rows";
      noMatches.hidden = visible !== 0;
    };
    input.addEventListener("input", filter);
    const exportButton = make("button", "Export CSV", "button");
    exportButton.type = "button";
    exportButton.setAttribute("aria-label", "Export visible rows from " + title);
    exportButton.addEventListener("click", () => {
      const visibleRows = [head.rows[0], ...Array.from(body.rows).filter(row => !row.hidden)];
      const csv = visibleRows.map(row => Array.from(row.cells).map(cell => csvCell(cellText(cell))).join(",")).join("\r\n");
      download("\uFEFF" + csv + "\r\n", "choleraflow-" + section.id + "-table-" + (index + 1) + ".csv", "text/csv;charset=utf-8");
    });
    controls.append(label, count, exportButton);
    scroll.before(controls);
    scroll.after(noMatches);
    Array.from(head.rows[0].cells).forEach((cell, column) => {
      cell.scope = "col";
      cell.setAttribute("aria-sort", "none");
      const button = make("button", cell.textContent, "sort-button");
      button.type = "button";
      button.addEventListener("click", () => {
        const descending = cell.getAttribute("aria-sort") === "ascending";
        Array.from(head.rows[0].cells).forEach(header => header.setAttribute("aria-sort", "none"));
        cell.setAttribute("aria-sort", descending ? "descending" : "ascending");
        const sorted = Array.from(body.rows).sort((a, b) => collator.compare(cellText(a.cells[column]), cellText(b.cells[column])) * (descending ? -1 : 1));
        sorted.forEach(row => body.append(row));
      });
      cell.replaceChildren(button);
    });
    filter();
  });
  document.querySelectorAll(".js-svg-export").forEach(button => {
    const figure = button.closest("figure");
    const source = figure.querySelector("svg");
    if (!source) return;
    button.hidden = false;
    button.addEventListener("click", () => {
      const svg = source.cloneNode(true);
      const namespace = "http://www.w3.org/2000/svg";
      // XMLSerializer supplies the namespace; setting a second plain xmlns
      // attribute produces invalid SVG in standards-compliant serializers.
      const dimensions = svg.getAttribute("viewBox").trim().split(/\s+/);
      if (figure.classList.contains("network-panel")) {
        // Keep the selected metadata legend with the standalone network graphic.
        const entries = Array.from(figure.querySelectorAll(".network-legend span"));
        const key = document.createElementNS(namespace, "g");
        const startY = Number(dimensions[3]) + 25;
        const heading = document.createElementNS(namespace, "text");
        heading.setAttribute("x", "24"); heading.setAttribute("y", startY);
        heading.setAttribute("font-size", "14"); heading.setAttribute("fill", "#172a3c");
        heading.textContent = "Color by " + figure.querySelector(".network-color option:checked").textContent + " · one node per sample";
        key.append(heading);
        entries.forEach((entry, index) => {
          const x = 24 + (index % 2) * (Number(dimensions[2]) / 2);
          const y = startY + 28 + Math.floor(index / 2) * 24;
          const marker = document.createElementNS(namespace, "circle");
          marker.setAttribute("cx", x); marker.setAttribute("cy", y - 4);
          marker.setAttribute("r", "5"); marker.setAttribute("fill", entry.dataset.color);
          const label = document.createElementNS(namespace, "text");
          label.setAttribute("x", x + 12); label.setAttribute("y", y);
          label.setAttribute("font-size", "12"); label.setAttribute("fill", "#172a3c");
          const value = entry.dataset.value;
          label.textContent = (value.length > 48 ? value.slice(0, 45) + "…" : value) + " (" + entry.dataset.count + ")";
          const full = document.createElementNS(namespace, "title"); full.textContent = value; label.append(full);
          key.append(marker, label);
        });
        svg.append(key);
        dimensions[3] = String(startY + 45 + Math.ceil(entries.length / 2) * 24);
        svg.setAttribute("viewBox", dimensions.join(" "));
        svg.querySelectorAll(".network-node").forEach(node => { node.classList.remove("dimmed"); node.removeAttribute("tabindex"); node.removeAttribute("role"); });
      }
      svg.setAttribute("width", dimensions[2]);
      svg.setAttribute("height", dimensions[3]);
      svg.style.width = dimensions[2] + "px";
      svg.style.height = dimensions[3] + "px";
      const title = document.createElementNS(namespace, "title");
      title.id = figure.id + "-export-title";
      title.textContent = figure.querySelector("h3").textContent;
      svg.setAttribute("aria-labelledby", title.id);
      svg.prepend(title);
      const style = document.createElementNS(namespace, "style");
      style.textContent = document.querySelector("head style").textContent;
      svg.prepend(style);
      download(new XMLSerializer().serializeToString(svg), "choleraflow-" + figure.id + ".svg", "image/svg+xml;charset=utf-8");
    });
  });
  document.querySelectorAll(".network-panel").forEach(panel => {
    const svg = panel.querySelector("svg");
    if (!svg) return;
    const nodes = Array.from(panel.querySelectorAll(".network-node"));
    const color = panel.querySelector(".network-color");
    const search = panel.querySelector(".network-find");
    const zoom = panel.querySelector(".network-zoom");
    const labels = panel.querySelector(".network-labels");
    const distances = panel.querySelector(".network-distances");
    const viewport = panel.querySelector(".network-viewport");
    const selection = panel.querySelector(".network-selection");
    const feedback = panel.querySelector(".network-feedback");
    const legends = panel.querySelector(".network-legend");
    const metadata = new Map(nodes.map(node => [node, JSON.parse(node.dataset.metadata)]));
    panel.querySelector(".network-controls").hidden = false;
    selection.textContent = "Select a sample to inspect its metadata. Drag the background or scroll to explore when zoomed.";
    const paint = () => {
      const field = color.value;
      const fieldName = color.selectedOptions[0].textContent;
      const counts = new Map();
      nodes.forEach(node => {
        const entry = metadata.get(node)[field];
        node.querySelector("circle").setAttribute("fill", entry.color);
        node.querySelector("title").textContent = node.dataset.sample + " · " + fieldName + ": " + entry.value + " · one sample";
        const previous = counts.get(entry.value);
        counts.set(entry.value, {color: entry.color, count: previous ? previous.count + 1 : 1});
      });
      legends.replaceChildren();
      Array.from(counts).sort((a, b) => collator.compare(a[0], b[0])).forEach(([value, entry]) => {
        const item = make("span");
        item.dataset.value = value; item.dataset.color = entry.color; item.dataset.count = entry.count;
        const swatch = make("i"); swatch.style.background = entry.color;
        item.append(swatch, document.createTextNode(value + " (" + entry.count + ")")); legends.append(item);
      });
      svg.querySelector("desc").textContent = "Minimum spanning forest from observed pairwise allele distances. One equal-sized vertex per sample. Edge labels show distances; line lengths are layout-only. Colors: " + fieldName + ".";
    };
    const find = () => {
      const query = search.value.trim().toLocaleLowerCase();
      let matches = 0;
      nodes.forEach(node => {
        const match = !!query && node.dataset.sample.toLocaleLowerCase().includes(query);
        node.classList.toggle("match", match);
        node.classList.toggle("dimmed", !!query && !match);
        if (match) matches++;
      });
      feedback.textContent = query ? matches + " of " + nodes.length + " matching samples · all nodes and edges retained" : "One node per sample · edge labels are observed allele differences.";
    };
    nodes.forEach(node => {
      node.setAttribute("tabindex", "0"); node.setAttribute("role", "button");
      node.setAttribute("aria-label", "Inspect sample " + node.dataset.sample);
      const select = () => {
        nodes.forEach(other => other.classList.toggle("selected", other === node));
        const values = metadata.get(node);
        selection.textContent = node.dataset.sample + " · " + Array.from(color.options).map(option => option.textContent + ": " + values[option.value].value).join(" · ");
      };
      node.addEventListener("click", select);
      node.addEventListener("keydown", event => { if (event.key === "Enter" || event.key === " ") { event.preventDefault(); select(); } });
    });
    color.addEventListener("change", paint);
    search.addEventListener("input", find);
    zoom.addEventListener("input", () => { svg.style.width = svg.style.height = zoom.value + "%"; });
    labels.addEventListener("change", () => svg.classList.toggle("hide-node-labels", !labels.checked));
    distances.addEventListener("change", () => svg.classList.toggle("hide-edge-distances", !distances.checked));
    panel.querySelector(".network-reset").addEventListener("click", () => {
      color.value = "country"; search.value = ""; zoom.value = "100";
      svg.style.width = svg.style.height = "100%"; labels.checked = nodes.length <= 30; distances.checked = true;
      svg.classList.toggle("hide-node-labels", !labels.checked); svg.classList.remove("hide-edge-distances");
      nodes.forEach(node => node.classList.remove("selected"));
      viewport.scrollLeft = viewport.scrollTop = 0;
      selection.textContent = "Select a sample to inspect its metadata. Drag the background or scroll to explore when zoomed.";
      paint(); find();
    });
    let drag;
    viewport.addEventListener("pointerdown", event => {
      if (event.button !== 0 || event.target.closest(".network-node")) return;
      drag = {x: event.clientX, y: event.clientY, left: viewport.scrollLeft, top: viewport.scrollTop};
      viewport.setPointerCapture?.(event.pointerId); viewport.classList.add("dragging");
    });
    viewport.addEventListener("pointermove", event => {
      if (!drag) return;
      viewport.scrollLeft = drag.left + drag.x - event.clientX;
      viewport.scrollTop = drag.top + drag.y - event.clientY;
    });
    ["pointerup", "pointercancel", "lostpointercapture"].forEach(type => viewport.addEventListener(type, () => { drag = null; viewport.classList.remove("dragging"); }));
  });
  document.querySelectorAll(".tree-panel").forEach(panel => {
    const svg = panel.querySelector("svg");
    if (!svg) return;
    panel.querySelector(".tree-controls").hidden = false;
    panel.querySelector(".tree-zoom").addEventListener("input", event => {
      svg.style.width = event.target.value + "%";
    });
    const input = panel.querySelector(".tree-find");
    const tips = Array.from(panel.querySelectorAll(".tree-tip"));
    input.addEventListener("input", () => {
      const query = input.value.trim().toLocaleLowerCase();
      let matches = 0;
      tips.forEach(tip => {
        const match = !!query && (tip.getAttribute("data-tip-label") || "").toLocaleLowerCase().includes(query);
        tip.classList.toggle("match", match);
        if (match) matches++;
      });
      panel.querySelector(".tree-match-count").textContent = query ? matches + " matching tips" : "";
    });
  });
  document.querySelectorAll(".sample-explorer").forEach(explorer => {
    explorer.querySelector(".sample-filter-label").hidden = false;
    const input = explorer.querySelector(".sample-filter");
    const records = Array.from(explorer.querySelectorAll(".sample-record"));
    input.addEventListener("input", () => {
      const query = input.value.trim().toLocaleLowerCase();
      records.forEach(record => record.hidden = !record.dataset.sample.toLocaleLowerCase().includes(query));
      explorer.querySelector(".sample-filter-count").textContent = records.filter(record => !record.hidden).length + " of " + records.length + " identifiers";
    });
  });
  let printDetails = [];
  window.addEventListener("beforeprint", () => {
    printDetails = Array.from(document.querySelectorAll("details:not([open])")).filter(item => !item.querySelector("pre"));
    printDetails.forEach(item => item.open = true);
  });
  window.addEventListener("afterprint", () => { printDetails.forEach(item => item.open = false); printDetails = []; });
  const printButton = document.getElementById("print-report");
  printButton.hidden = false;
  printButton.addEventListener("click", () => window.print());
  const links = Array.from(document.querySelectorAll("nav.toc a"));
  if ("IntersectionObserver" in window) {
    const visible = new Set();
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => entry.isIntersecting ? visible.add(entry.target.id) : visible.delete(entry.target.id));
      const active = links.find(link => visible.has(link.hash.slice(1)));
      if (!active) return;
      links.forEach(link => link.removeAttribute("aria-current"));
      active.setAttribute("aria-current", "location");
    }, {rootMargin: "-5% 0px -45% 0px"});
    document.querySelectorAll("main > section").forEach(section => observer.observe(section));
  }
})();
