{%- from 'partials/macros.html.j2' import badge, notice -%}
{%- from 'partials/icons.html.j2' import icon, icon_templates -%}
<!DOCTYPE html>
<html lang="en" class="no-js" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data: blob:; font-src data:; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="generator" content="CholeraFlow {{ run.version }}">
<meta name="description" content="CholeraFlow Genomic Surveillance Explorer: offline report for Vibrio cholerae genomic characterisation and outbreak investigation.">
<title>CholeraFlow · Genomic Surveillance Explorer{% if demo|default(false) %} (synthetic demonstration){% endif %}</title>
<style>
{{ assets.css|safe }}
:root { {{ palette.css.light|safe }} }
:root[data-theme="dark"] { {{ palette.css.dark|safe }} }
{% include 'report.css.j2' %}
</style>
</head>
<body class="cf-body{% if demo|default(false) %} is-demo{% endif %}">
<a class="skip-link" href="#main-content">Skip to report content</a>
<svg class="cf-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="cf-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" class="cf-hatch-bg"/><line x1="0" y1="0" x2="0" y2="6" class="cf-hatch-line"/></pattern>
  </defs>
</svg>
<div class="cf-app" id="cf-app">

<aside class="cf-sidebar" id="cf-sidebar" aria-label="Report navigation">
  <div class="cf-brand">
    <svg class="cf-brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <rect width="40" height="40" rx="10" class="cf-brand-tile"/>
      <path d="M11.5 27.5c-.6-7.4 4.4-13.4 12.6-14.2" class="cf-brand-rod"/>
      <path d="M24.1 13.3c2.4-.5 3.3-2.6 5.4-2.3 1.9.3 2.1 2.2 3.9 2" class="cf-brand-flagellum"/>
      <circle cx="11.5" cy="27.5" r="1.1" class="cf-brand-dot"/>
      <path d="M8 33h7m-3.5 0v-3m9 3h6m-3 0v-2.2" class="cf-brand-tree"/>
    </svg>
    <div class="cf-brand-text">
      <span class="cf-brand-name">CholeraFlow</span>
      <span class="cf-brand-caption">Genomic Surveillance Explorer</span>
    </div>
    <button class="cf-icon-btn cf-sidebar-collapse" type="button" data-cf-action="collapse-sidebar" aria-label="Collapse navigation" aria-pressed="false" hidden>{{ icon('panel-left-close') }}</button>
  </div>
  {% if demo|default(false) %}<p class="cf-sidebar-demo">{{ icon('flask-conical') }}<span>Synthetic demonstration</span></p>{% endif %}
  <nav class="cf-nav" aria-label="Report sections">
    {% for group in nav.groups %}
    <details class="cf-nav-group" open>
      <summary class="cf-nav-group-title">{{ group.title }}{{ icon('chevron-down', 'cf-nav-chevron') }}</summary>
      <ul>
        {% for page in group.pages %}
        <li><a class="cf-nav-link" href="#{{ page.id }}" data-page="{{ page.id }}" title="{{ page.title }}">{{ icon(page.icon) }}<span>{{ page.title }}</span></a></li>
        {% endfor %}
      </ul>
    </details>
    {% endfor %}
  </nav>
  <div class="cf-sidebar-footer">
    <p>{{ icon('lock') }}<span>Offline · self-contained file</span></p>
    <p class="cf-sidebar-meta">CholeraFlow {{ run.version }}<br>Generated {{ run.generated_at or run.date }}</p>
  </div>
</aside>
<div class="cf-scrim" data-cf-action="close-sidebar" hidden></div>

<div class="cf-shell">
  <header class="cf-toolbar" role="banner">
    <button class="cf-icon-btn cf-menu-btn" type="button" data-cf-action="toggle-sidebar" aria-controls="cf-sidebar" aria-expanded="false" aria-label="Open navigation" hidden>{{ icon('menu') }}</button>
    <div class="cf-toolbar-title">
      <nav class="cf-breadcrumb" aria-label="Breadcrumb"><ol><li>CholeraFlow</li><li data-cf-crumb-group>Report</li><li aria-current="page" data-cf-crumb-page>All sections</li></ol></nav>
      <p class="cf-toolbar-heading">Genomic Surveillance Explorer{% if demo|default(false) %} {{ badge('Synthetic', 'demo', 'flask-conical') }}{% endif %}</p>
    </div>
    <div class="cf-toolbar-search" data-cf-search hidden>
      <label class="cf-search">
        {{ icon('search') }}
        <span class="sr-only">Search samples and report sections</span>
        <input type="search" id="cf-search-input" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="cf-search-results" autocomplete="off" spellcheck="false" placeholder="Search samples or sections">
        <kbd class="cf-kbd" aria-hidden="true">/</kbd>
      </label>
      <ul class="cf-search-results" id="cf-search-results" role="listbox" aria-label="Search results" hidden></ul>
    </div>
    <div class="cf-toolbar-actions" data-cf-toolbar-actions hidden>
      <button class="cf-btn cf-btn--ghost" type="button" data-cf-action="open-filters" aria-haspopup="dialog" aria-expanded="false" aria-controls="cf-filter-panel">{{ icon('filter') }}<span class="cf-btn-label">Filters</span><span class="cf-count-pill" data-cf-filter-count hidden>0</span></button>
      <div class="cf-menu-wrap">
        <button class="cf-icon-btn" type="button" data-cf-menu="cf-display-menu" aria-haspopup="menu" aria-expanded="false" aria-label="Display options">{{ icon('sliders-horizontal') }}</button>
        <div class="cf-menu" id="cf-display-menu" role="menu" aria-label="Display options" hidden>
          <p class="cf-menu-label" id="cf-theme-label">Theme</p>
          <div role="group" aria-labelledby="cf-theme-label">
            <button type="button" role="menuitemradio" aria-checked="true" data-cf-theme="light">{{ icon('sun') }}<span>Light</span></button>
            <button type="button" role="menuitemradio" aria-checked="false" data-cf-theme="dark">{{ icon('moon') }}<span>Dark</span></button>
            <button type="button" role="menuitemradio" aria-checked="false" data-cf-theme="system">{{ icon('monitor') }}<span>Match system</span></button>
          </div>
          <p class="cf-menu-label" id="cf-layout-label">Layout</p>
          <div role="group" aria-labelledby="cf-layout-label">
            <button type="button" role="menuitemradio" aria-checked="true" data-cf-layout="paged">{{ icon('layout-dashboard') }}<span>One section at a time</span></button>
            <button type="button" role="menuitemradio" aria-checked="false" data-cf-layout="continuous">{{ icon('list') }}<span>Continuous report</span></button>
          </div>
          <div class="cf-menu-sep" role="separator"></div>
          <button type="button" role="menuitem" data-cf-action="presentation">{{ icon('presentation') }}<span>Presentation mode</span></button>
        </div>
      </div>
      <button class="cf-icon-btn" type="button" data-cf-action="help" aria-haspopup="dialog" aria-label="Help and interpretation guide">{{ icon('circle-help') }}</button>
      <button class="cf-icon-btn" type="button" data-cf-action="print" aria-label="Print or save as PDF">{{ icon('printer') }}</button>
      <div class="cf-menu-wrap">
        <button class="cf-btn cf-btn--primary" type="button" data-cf-menu="cf-export-menu" aria-haspopup="menu" aria-expanded="false">{{ icon('download') }}<span class="cf-btn-label">Export</span>{{ icon('chevron-down') }}</button>
        <div class="cf-menu cf-menu--wide" id="cf-export-menu" role="menu" aria-label="Export" hidden></div>
      </div>
    </div>
  </header>

  <div class="cf-filterbar" id="cf-filterbar" role="region" aria-label="Active filters" hidden>
    <span class="cf-filterbar-label">{{ icon('filter') }}<span data-cf-filter-summary>Filtered view</span></span>
    <ul class="cf-chips" data-cf-filter-chips></ul>
    <button class="cf-btn cf-btn--ghost cf-btn--sm" type="button" data-cf-action="clear-filters">{{ icon('x') }}<span>Clear all</span></button>
  </div>

  <main id="main-content" class="cf-main" tabindex="-1">
    {% if demo|default(false) %}
    {% call notice('Synthetic demonstration — not validated surveillance results.', 'demo', cls='cf-demo-banner') %}
      <p>All sample values in this report are software test fixtures. They are not validated surveillance results and must not be used for public health decisions.</p>
    {% endcall %}
    {% endif %}
    <noscript><div class="cf-noscript">{{ icon('info') }}<p>Scripting is disabled, so every section is shown in sequence. All results, tables and figures remain readable; interactive filtering, search and exports need JavaScript.</p></div></noscript>
    {% for page_id in nav.order %}
    {% set page = nav.pages[page_id] %}
    <section class="cf-page" id="{{ page.id }}" data-group="{{ page.group }}" aria-labelledby="{{ page.id }}-title">
      {% include 'partials/sections/' ~ page.id ~ '.html.j2' %}
    </section>
    {% endfor %}
  </main>
  <footer class="cf-footer">
    <p><strong>CholeraFlow {{ run.version }}</strong> · Generated {{ run.generated_at or run.date }} · This report is a screening and communication aid; findings require integration with epidemiological and clinical data.</p>
    <p class="cf-footer-meta">Self-contained offline file. No data leave this document. Report schema {{ model.schema }}.</p>
  </footer>
</div>

<aside class="cf-drawer" id="cf-drawer" role="dialog" aria-modal="false" aria-labelledby="cf-drawer-title" hidden>
  <header class="cf-drawer-header">
    <div>
      <p class="cf-drawer-eyebrow" data-cf-drawer-eyebrow>Sample record</p>
      <h2 class="cf-drawer-title" id="cf-drawer-title" data-cf-drawer-title>Record</h2>
    </div>
    <button class="cf-icon-btn" type="button" data-cf-action="close-drawer" aria-label="Close details panel">{{ icon('x') }}</button>
  </header>
  <div class="cf-drawer-body" data-cf-drawer-body></div>
</aside>

<div class="cf-popover cf-filter-panel" id="cf-filter-panel" role="dialog" aria-modal="false" aria-labelledby="cf-filter-title" hidden>
  <header class="cf-popover-header"><h2 id="cf-filter-title">Filter samples</h2><button class="cf-icon-btn" type="button" data-cf-action="close-filters" aria-label="Close filters">{{ icon('x') }}</button></header>
  <p class="cf-popover-note">Filters change which samples are highlighted or listed. They never change analytical results; full-cohort figures say so.</p>
  <div class="cf-popover-body" data-cf-filter-fields></div>
</div>

<dialog class="cf-dialog" id="cf-help" aria-labelledby="cf-help-title">
  <header class="cf-dialog-header"><h2 id="cf-help-title">{{ icon('circle-help') }}Using this report</h2><button class="cf-icon-btn" type="button" data-cf-action="close-help" aria-label="Close help">{{ icon('x') }}</button></header>
  <div class="cf-dialog-body">
    <h3>Reading states</h3>
    <ul class="cf-help-states">
      <li><span class="cf-badge cf-badge--pass">{{ icon('circle-check') }}<span>Pass / Present</span></span> reported by the source output.</li>
      <li><span class="cf-badge cf-badge--neutral">{{ icon('circle-minus') }}<span>Absent / No marker reported</span></span> assessed, not detected. This is not phenotypic susceptibility.</li>
      <li><span class="cf-badge cf-badge--na">{{ icon('ban') }}<span>Not assessed / Not performed</span></span> no assessment exists; never a negative call.</li>
      <li><span class="cf-badge cf-badge--missing">{{ icon('circle-dashed') }}<span>Not available</span></span> the value is missing or invalid in the source.</li>
      <li><span class="cf-badge cf-badge--review">{{ icon('git-compare') }}<span>Review</span></span> sources disagree; both values are shown and none is preferred.</li>
    </ul>
    <h3>Keyboard</h3>
    <ul class="cf-help-keys">
      <li><kbd class="cf-kbd">/</kbd> search samples and sections</li>
      <li><kbd class="cf-kbd">[</kbd> <kbd class="cf-kbd">]</kbd> previous / next section</li>
      <li><kbd class="cf-kbd">Esc</kbd> close panels, menus and dialogs</li>
      <li><kbd class="cf-kbd">?</kbd> open this guide</li>
    </ul>
    <p>Select a sample anywhere (table, tree tip, matrix cell or network node) to open its record without leaving the current view. Genomic clustering does not prove transmission, and AMR genotype does not establish phenotype.</p>
    <p><a href="#guide" data-cf-action="close-help">Open the full interpretation guide</a></p>
  </div>
</dialog>

<div class="cf-tooltip" id="cf-tooltip" role="tooltip" hidden></div>
<div class="sr-only" id="cf-live" aria-live="polite" aria-atomic="true"></div>
{{ icon_templates() }}
<script type="application/json" id="cf-data">{{ model|json_safe|tojson }}</script>
<script>
{% include 'report.js.j2' %}
</script>
</body>
</html>
