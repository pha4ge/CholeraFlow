manifest {
    name            = 'CholeraFlow'
    description     = 'Nextflow pipeline for V. cholerae genomic surveillance'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.2.0'
}

// ── Parameters ────────────────────────────────────────────────────────────────

params {
    help = false
    // Input / Output
    input    = null
    metadata = null
    outdir   = 'results'

    // Analysis mode (must match GUI mode names)
    use_case  = 'outbreak'
    data_type = 'short'   // short | long | hybrid | fasta

    // Analysis toggles
    global_context = false
    run_amr        = true
    run_virulence  = true
    run_plasmid    = false
    run_cgmlst     = true
    run_phylogeny  = true
    report_level   = 'full'   // rapid | full

    // Technical parameters — CholeraSeq validated defaults
    min_trim_quality       = 20
    min_trim_length        = 50
    min_mapping_quality    = 20
    min_base_quality       = 20
    min_site_coverage      = 5
    min_allele_fraction    = 0.75
    max_missing_percentage = 50
    min_parsimony_coverage = 0.70

    // Outbreak cluster thresholds — PHA4GE Cholera Guidance Document
    snp_outbreak_threshold  = 5
    snp_cluster_threshold   = 50
    cgmlst_outbreak_alleles = 10
    cgmlst_cluster_alleles  = 50

    // Phylogenetics
    skip_fastbaps           = true
    run_fastbaps            = false
    gubbins_tree_builder    = 'raxml'   // raxml | fasttree | iqtree — raxml is default

    // Reference files (bundled)
    ref_fasta   = "${projectDir}/assets/references/N16961.fasta"
    ref_genbank = "${projectDir}/assets/references/GCF_003063785.full.gbk"

    // Optional global context alignment (downloaded separately)
    global_core_alignment = null

    // Bactopia integration
    // Profile passed to the inner `bactopia` call — independent of CholeraFlow's
    // own profile. Set to 'docker' when Docker is available (recommended),
    // 'singularity' on HPC, or 'conda' as a fallback.
    bactopia_profile = 'docker'
    // Bactopia executable. The portable default resolves from PATH. If Bactopia
    // is installed in a dedicated conda environment that is not activated, pass
    // --bactopia_bin /absolute/path/to/bactopia explicitly.
    bactopia_bin = 'bactopia'
    // Optional explicit inner Nextflow pin; otherwise Bactopia selects its runtime.
    bactopia_nextflow_version = null
    report_container = 'python:3.11-slim'
    database_manifest = "${projectDir}/assets/databases/database_manifest.json"

    // Step 3–4 database paths (optional — pipeline degrades gracefully if not set)
    virulencefinder_db = null  // path to cloned virulencefinder_db git repo
                               // git clone https://bitbucket.org/genomicepidemiology/virulencefinder_db.git
    resfinder_db       = null  // path to cloned resfinder_db git repo
                               // git clone https://bitbucket.org/genomicepidemiology/resfinder_db.git
    cgmlst_schema      = null
                               // EnteroBase Vibrio cgMLST v1 (VIBwgMLST.cgMLSTv1; 1,128 loci).
                               // Download raw loci with scripts/setup_databases.py, then adapt them
                               // with chewBBACA PrepExternalSchema and pass --cgmlst_schema <prepared_dir>.
                               // See assets/databases/cgmlst_vibrio/README.md

    // Compute limits (overridden per profile)
    max_cpus   = 8
    max_memory = '32.GB'
    max_time   = '48.h'
}

// ── Profiles ──────────────────────────────────────────────────────────────────

profiles {

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        apptainer.enabled      = false
        conda.enabled          = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }

    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
        conda.enabled          = false
    }

    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
    }

    hpc {
        process.executor       = 'slurm'
    }

    // LMIC / laptop — 2 CPU, 6 GB RAM; disables plasmid detection and global context
    low_resource {
        params.max_cpus       = 2
        params.max_memory     = '6.GB'
        params.max_time       = '72.h'
        params.run_plasmid    = false
        params.global_context = false
    }

    // Bundled example data. Requires downloads, Bactopia and scientific tools;
    // this is not the lightweight CI smoke test.
    test {
        params.input            = "${projectDir}/tests/testdata/local_samplesheet.csv"
        params.metadata         = "${projectDir}/tests/testdata/choleraseq_metadata.csv"
        params.outdir           = 'test_results'
        params.max_cpus         = 2
        params.max_memory       = '6.GB'
        params.max_time         = '2.h'
        // Bactopia runs Docker containers internally via its own profile
        params.bactopia_profile = 'docker'

        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
        conda.enabled       = false
    }
}

// ── Base config ───────────────────────────────────────────────────────────────

includeConfig 'conf/base.config'

// ── Output publishing (PIPELINE_SPEC.md Section 8) ─────────────────────────────

includeConfig 'conf/modules.config'

// Record execution details for every run, including failed runs.
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.dot"
    overwrite = true
}
