// ── Output publishing (PIPELINE_SPEC.md Section 8) ────────────────────────────
//
// Centralised publishDir directives, keyed by process name. Kept out of the
// module files so the Section 8 output tree is defined in one place and so the
// aliased reuse processes (IQTREE2 vs IQTREE2_GLOBAL, VARCODONS vs
// VARCODONS_GLOBAL) can publish to different directories.
//
// Patterns are `$`-anchored on the process name so that a name which is a prefix
// of another (GENOME_QC vs GENOME_QC_AGGREGATE, SNIPPY vs SNIPPY_CORE,
// IQTREE2 vs IQTREE2_GLOBAL) does not match the longer one.
//
// mode:'copy' so results/ holds real files (survive `work/` cleanup) — the report
// and downloads depend on this.
// ─────────────────────────────────────────────────────────────────────────────

process {

    // ── Input validation → pipeline_info/ ─────────────────────────────────────
    withName: 'INPUT_VALIDATE$' {
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: 'copy', overwrite: true ]
    }

    // ── QC (Step 2 genome QC, Step 6 sequence QC) → qc/ ───────────────────────
    withName: 'GENOME_QC$' {
        publishDir = [ path: { "${params.outdir}/qc/genome_qc" }, mode: 'copy', overwrite: true ]
    }
    withName: 'GENOME_QC_AGGREGATE$' {
        publishDir = [ path: { "${params.outdir}/qc" }, mode: 'copy', overwrite: true ]
    }
    withName: 'SEQ_CLEANER$' {
        publishDir = [ path: { "${params.outdir}/qc/seq_qc" }, mode: 'copy', overwrite: true ]
    }
    withName: 'SEQ_CLEANER_FILTER$' {
        publishDir = [ path: { "${params.outdir}/qc" }, mode: 'copy', overwrite: true ]
    }

    // ── Cholera characterisation → characterisation/ ──────────────────────────
    // cholera_typing.py covers species confirmation + serogroup/biotype/CTX/SXT.
    withName: 'CHOLERA_TYPING$' {
        publishDir = [ path: { "${params.outdir}/characterisation/species" }, mode: 'copy', overwrite: true ]
    }
    withName: 'CHOLERA_TYPING_AGGREGATE$' {
        publishDir = [ path: { "${params.outdir}/characterisation/species" }, mode: 'copy', overwrite: true ]
    }
    withName: 'VIRULENCEFINDER$' {
        publishDir = [ path: { "${params.outdir}/characterisation/virulence" }, mode: 'copy', overwrite: true ]
    }
    withName: 'VIRULENCEFINDER_AGGREGATE$' {
        publishDir = [ path: { "${params.outdir}/characterisation/virulence" }, mode: 'copy', overwrite: true ]
    }
    withName: 'RESFINDER$' {
        publishDir = [ path: { "${params.outdir}/characterisation/amr/resfinder" }, mode: 'copy', overwrite: true ]
    }
    withName: 'AMR_MERGE$' {
        publishDir = [ path: { "${params.outdir}/characterisation/amr" }, mode: 'copy', overwrite: true ]
    }
    withName: 'AMR_AGGREGATE$' {
        publishDir = [ path: { "${params.outdir}/characterisation/amr" }, mode: 'copy', overwrite: true ]
    }

    // ── Reference mapping (Snippy per-sample) → mapping/<sample>/ ──────────────
    withName: 'SNIPPY$' {
        publishDir = [ path: { "${params.outdir}/mapping/${meta.id}" }, mode: 'copy', overwrite: true ]
    }

    // ── Phylogenetics (Steps 7–10a) → phylogenetics/ ──────────────────────────
    withName: 'SNIPPY_CORE$' {
        publishDir = [ path: { "${params.outdir}/phylogenetics" }, mode: 'copy', overwrite: true ]
    }
    withName: 'GUBBINS$' {
        publishDir = [ path: { "${params.outdir}/phylogenetics" }, mode: 'copy', overwrite: true ]
    }
    withName: 'VARCODONS$' {
        publishDir = [ path: { "${params.outdir}/phylogenetics" }, mode: 'copy', overwrite: true ]
    }
    withName: 'IQTREE2$' {
        publishDir = [ path: { "${params.outdir}/phylogenetics" }, mode: 'copy', overwrite: true ]
    }
    withName: 'SNP_DISTS$' {
        publishDir = [ path: { "${params.outdir}/phylogenetics" }, mode: 'copy', overwrite: true ]
    }

    // ── cgMLST (Steps 9b, 10b) → cgmlst/ ──────────────────────────────────────
    withName: 'CHEWBBACA$' {
        publishDir = [ path: { "${params.outdir}/cgmlst" }, mode: 'copy', overwrite: true ]
    }
    withName: 'CGMLST_DISTANCES$' {
        publishDir = [ path: { "${params.outdir}/cgmlst" }, mode: 'copy', overwrite: true ]
    }

    // ── Global context (Step 11) → global_context/ ────────────────────────────
    withName: 'MERGE_ALIGNMENTS$' {
        publishDir = [ path: { "${params.outdir}/global_context" }, mode: 'copy', overwrite: true ]
    }
    withName: 'VARCODONS_GLOBAL$' {
        publishDir = [ path: { "${params.outdir}/global_context" }, mode: 'copy', overwrite: true ]
    }
    withName: 'IQTREE2_GLOBAL$' {
        publishDir = [ path: { "${params.outdir}/global_context" }, mode: 'copy', overwrite: true ]
    }

    // ── Outbreak interpretation (Step 12) → outbreak/ ─────────────────────────
    withName: 'OUTBREAK_CLUSTER$' {
        publishDir = [ path: { "${params.outdir}/outbreak" }, mode: 'copy', overwrite: true ]
    }

    // ── Report (Step 13) → reports/ ───────────────────────────────────────────
    withName: 'GENERATE_REPORT$' {
        publishDir = [ path: { "${params.outdir}/reports" }, mode: 'copy', overwrite: true ]
    }
}
